{
    "ver": "0.4.4",
    "authors": [
        "rbdavid",
        "hdemeyer"
    ],
    "contact": "rbdavid@illinois.edu",
    "categories": [
        "active"
    ],
    "widgets": {
        "input": null,
        "output": "no-display"
    },
    "parameters": [
        {
            "id": "protein_sequence_set_data_obj",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "field_type": "text",
            "text_options": {
                "valid_ws_types": ["KBaseSequences.ProteinSequenceSet"]
            }
        },
        {
            "id": "header_format",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [
                "UniProt"
            ],
            "field_type": "dropdown",
            "dropdown_options": {
                "options": [
                    {
                        "value": "UniProt",
                        "display": "UniProt IDs"
                    },
                    {
                        "value": "UniRef90",
                        "display": "UniRef90 Cluster IDs"
                    },
                    {
                        "value": "UniRef50",
                        "display": "UniRef50 Cluster IDs"
                    }
                ]
            }
        },
        {
            "id": "est_object_name",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": ["blast_edge_file"],
            "field_type": "text"
        },
        {
            "id": "taxonomic_level",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                ""
            ],
            "field_type": "dropdown",
            "dropdown_options": {
                "options": [
                    {
                        "value": "Superkingdom",
                        "display": "Superkingdom"
                    },
                    {
                        "value": "Kingdom",
                        "display": "Kingdom"
                    },
                    {
                        "value": "Pylum",
                        "display": "Phylum"
                    },
                    {
                        "value": "Class",
                        "display": "Class"
                    },
                    {
                        "value": "Order",
                        "display": "Order"
                    },
                    {
                        "value": "Family",
                        "display": "Family"
                    },
                    {
                        "value": "Genus",
                        "display": "Genus"
                    },
                    {
                        "value": "Species",
                        "display": "Species"
                    }
                ]
            }
        },
        {
            "id": "taxon_filter_string",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                ""
            ],
            "field_type": "text"
        },
        {
            "id": "families",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                ""
            ],
            "field_type": "text"
        },
        {
            "id": "fraction",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                "1"
            ],
            "field_type": "text",
            "text_options": {
                "valid_ws_types": [],
                "validate_as": "int",
                "min_int": 1
            }
        },
        {
            "id": "blast_e_value",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                "5"
            ],
            "field_type": "text",
            "text_options": {
                "valid_ws_types": [],
                "validate_as": "int"
            }
        },
        {
            "id": "blast_num_matches",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                "250"
            ],
            "field_type": "text",
            "text_options": {
                "valid_ws_types": [],
                "validate_as": "int",
                "min_int": 1
            }
        }
    ],
    "parameter-groups": [
        {
            "id": "import_fasta_options",
            "parameters": [
                "protein_sequence_set_data_obj",
                "header_format"
            ],
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "with_border": true
        },
        {
            "id": "taxonomy_filter_options",
            "parameters": [
                "taxonomic_level",
                "taxon_filter_string"
            ],
            "optional": true,
            "advanced": true,
            "allow_multiple": true,
            "with_border": true
        },
        {
            "id": "protein_family_addition_options",
            "parameters": [
                "families",
                "fraction"
            ],
            "optional": true,
            "advanced": true,
            "allow_multiple": false,
            "with_border": true
        },
        {
            "id": "all_by_all_blast_options",
            "parameters": [
                "blast_e_value",
                "blast_num_matches"
            ],
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "with_border": true
        }
    ],
    "behavior": {
        "service-mapping": {
            "url": "",
            "name": "EFIToolsKBase",
            "method": "run_EFI_EST_FASTA",
            "input_mapping": [
                {
                    "narrative_system_variable": "workspace",
                    "target_property": "workspace_name"
                },
                {
                    "input_parameter": "import_fasta_options",
                    "target_property": "import_fasta_options"
                },
                {
                    "input_parameter": "est_object_name",
                    "target_property": "est_object_name"
                },
                {
                    "input_parameter": "taxonomy_filter_options",
                    "target_property": "taxonomy_filter_options"
                },
                {
                    "input_parameter": "protein_family_addition_options",
                    "target_property": "protein_family_addition_options"
                },
                {
                    "input_parameter": "all_by_all_blast_options",
                    "target_property": "all_by_all_blast_options"
                }
            ],
            "output_mapping": [
                {
                    "service_method_output_path": [
                        0,
                        "report_name"
                    ],
                    "target_property": "report_name"
                },
                {
                    "service_method_output_path": [
                        0,
                        "report_ref"
                    ],
                    "target_property": "report_ref"
                },
                {
                    "service_method_output_path": [
                        0,
                        "edge_ref"
                    ],
                    "target_property": "edge_ref"
                },
                {
                    "service_method_output_path": [
                        0,
                        "fasta_ref"
                    ],
                    "target_property": "fasta_ref"
                },
                {
                    "narrative_system_variable": "workspace",
                    "target_property": "workspace_name"
                }
            ]
        }
    },
    "job_id_output_field": "docker"
}
