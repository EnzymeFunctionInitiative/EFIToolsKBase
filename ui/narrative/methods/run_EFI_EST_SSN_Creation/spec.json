{
    "ver": "0.4.5",
    "authors": [
        "rbdavid",
        "hdemeyer",
        "nilsoberg"
    ],
    "contact": "efi@enzymefunction.org",
    "categories": [
	"active"
    ],
    "widgets": {
        "input": null,
        "output": "no-display"
    },
    "parameters": [
        {
            "id": "blast_edge_file_ref",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [ "" ],
            "field_type": "text",
            "text_options": {
                "valid_ws_types": ["EFIToolsKBase.BlastEdgeFile"]
            }
        },
        {
            "id": "filter_parameter",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [ "alignment_score" ],
            "field_type": "dropdown",
            "dropdown_options": {
                "options": [
		    {
                        "value": "alignment_score",
                        "display": "Alignment Score"
                    },
                    {
                        "value": "pident",
                        "display": "Percent Identity (0-100)"
                    },
                    {
                        "value": "bitscore",
                        "display": "Bit Score"
                    }
		]
            }
        },
        {
            "id": "filter_value",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [ "" ],
            "field_type": "text",
            "text_options": {
                "validate_as": "float"
            }
        },
        {
            "id": "min_length",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [ "0" ],
            "field_type": "text",
            "text_options": {
                "validate_as": "int",
                "min_integer": 0
            }
        },
        {
            "id": "max_length",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [ "50000" ],
            "field_type": "text",
            "text_options": {
                "validate_as": "int",
                "min_integer": 0
            }
        },
        {
            "id": "ssn_title",
            "optional": true,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [ "" ],
            "field_type": "text"
        },
        {
            "id": "ssn_object_name",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [ "ssn_file" ],
            "field_type": "text"
        },
        {
            "id": "exclude_fragments",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                false
            ],
            "field_type": "checkbox",
            "checkbox_options": {
                "unchecked_value": false,
                "checked_value": true
            }
        },
        {
            "id": "taxonomic_level",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                ""
            ],
            "field_type": "dropdown",
            "dropdown_options": {
                "options": [
                    {
                        "value": "Superkingdom",
                        "display": "Superkingdom"
                    },
                    {
                        "value": "Kingdom",
                        "display": "Kingdom"
                    },
                    {
                        "value": "Pylum",
                        "display": "Phylum"
                    },
                    {
                        "value": "Class",
                        "display": "Class"
                    },
                    {
                        "value": "Order",
                        "display": "Order"
                    },
                    {
                        "value": "Family",
                        "display": "Family"
                    },
                    {
                        "value": "Genus",
                        "display": "Genus"
                    },
                    {
                        "value": "Species",
                        "display": "Species"
                    }
                ]
            }
        },
        {
            "id": "taxon_filter_string",
            "optional": false,
            "advanced": true,
            "allow_multiple": true,
            "default_values": [
                ""
            ],
            "field_type": "text"
        }
    ],
    "parameter-groups": [
        {
            "id": "metric_filter_options",
            "parameters": [
                "filter_parameter",
                "filter_value"
            ],
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "with_border": true
        },
        {
            "id": "sequence_length_options",
            "parameters": [
                "min_length",
                "max_length"
            ],
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "with_border": true
        },
        {
            "id": "fragment_option",
            "parameters": [
                "exclude_fragments"
            ],
            "optional": true,
            "advanced": true,
            "allow_multiple": false,
            "with_border": true
        },
        {
            "id": "taxonomy_filter_options",
            "parameters": [
                "taxonomic_level",
                "taxon_filter_string"
            ],
            "optional": true,
            "advanced": true,
            "allow_multiple": true,
            "with_border": true
        }
    ],
    "behavior": {
        "service-mapping": {
            "url": "",
            "name": "EFIToolsKBase",
            "method": "run_EFI_EST_SSN_Creation",
            "input_mapping": [
                {
                    "narrative_system_variable": "workspace",
                    "target_property": "workspace_name"
                },
                {
                    "input_parameter": "blast_edge_file_ref",
                    "target_property": "blast_edge_file_ref",
                    "target_type_transform": "resolved-ref"

                },
                {
                    "input_parameter": "metric_filter_options",
                    "target_property": "metric_filter_options"
                },
                {
                    "input_parameter": "sequence_length_options",
                    "target_property": "sequence_length_options"
                },
                {
                    "input_parameter": "ssn_title",
                    "target_property": "ssn_title"
                },
                {
                    "input_parameter": "ssn_object_name",
                    "target_property": "ssn_object_name"
                },
                {
                    "input_parameter": "fragment_option",
                    "target_property": "fragment_option"
                },
                {
                    "input_parameter": "taxonomy_filter_options",
                    "target_property": "taxonomy_filter_options"
                }
            ],
            "output_mapping": [
                {
                    "service_method_output_path": [0,"report_name"],
                    "target_property": "report_name"
                },
                {
                    "service_method_output_path": [0,"report_ref"],
                    "target_property": "report_ref"
                },
                {
                    "narrative_system_variable": "workspace",
                    "target_property": "workspace_name"
                }
            ]
        }
    },
    "job_id_output_field": "docker"
}
